// Prisma schema for EcoNexus
// Smart Waste Management & Collection System for Nashik, Maharashtra
// Configured for SQLite with strict constraints, indexes, and full relational integrity

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------
// 1. AUTHENTICATION & STAKEHOLDER IDENTITY (3 Roles Only)
// ---------------------------------------------------------------------
model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String?        // Nullable for passwordless OTP citizen accounts
  name            String
  role            String         @default("CITIZEN") // Exactly: ORGANIZATION_ADMIN, WORKER, CITIZEN
  status          String         @default("active")  // active, pending, disabled
  isEmailVerified Boolean        @default(true)
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  workerProfile   WorkerProfile?
  complaints      Complaint[]
  ewasteRequests  EWasteRequest[]
  assignedTasks   CollectionTask[]
  assignedEWaste  EWasteRequest[] @relation("AssignedWorker")
  reportedIssues  OperationalIssue[]
  auditLogs       AuditLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([role])
  @@index([status])
}

model Organization {
  id              String         @id @default(uuid())
  name            String         @unique
  code            String         @unique // e.g. NMC-SWM
  orgType         String         @default("municipal_corporation") // municipal_corporation, authorized_contractor
  officialEmail   String
  phone           String?
  address         String?
  city            String         @default("Nashik")
  status          String         @default("approved") // approved, suspended
  users           User[]
  workers         WorkerProfile[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OrganizationRegistrationRequest {
  id                  String     @id @default(uuid())
  organizationName    String
  organizationType    String
  officialWorkEmail   String
  adminName           String
  contactPhone        String
  verificationDetails String?
  reasonForRequest    String
  status              String     @default("pending") // pending, approved, rejected
  reviewedBy          String?
  reviewNotes         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([status])
}

model WorkerProfile {
  id                       String       @id @default(uuid())
  userId                   String       @unique
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id])
  workerId                 String       @unique // Unique Employee/Worker ID (e.g. WRK-NSK-101)
  orgCode                  String       // Matching organization code (e.g. NMC-SWM)
  phone                    String?
  assignedWard             String?
  vehicleType              String?      // compactor_truck, tipper_truck, e_rickshaw, mini_truck
  isActivated              Boolean      @default(false)
  activationToken          String?
  activationTokenExpiresAt DateTime?
  status                   String       @default("active") // active, on_leave, revoked
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@index([workerId])
  @@index([orgCode])
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  email      String
  otpCode    String   // 6-digit OTP code or cryptographic hash
  token      String   @unique
  purpose    String   // citizen_signup, citizen_login, worker_activation, password_reset
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([token])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. USER_PROVISIONED, BIN_CREATED, COMPLAINT_RESOLVED
  resource   String
  resourceId String?
  details    String?  // JSON stringified payload
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------
// 2. MUNICIPAL WARDS & ASSETS
// ---------------------------------------------------------------------
model Ward {
  id                  String               @id @default(uuid())
  name                String               @unique
  code                String               @unique
  zone                String
  areaSqKm            Float
  populationEstimated Int
  censusYear          Int                  @default(2011)
  latitude            Float
  longitude           Float
  boundaryGeoJson     String?              // GeoJSON polygon geometry string
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bins                Bin[]
  complaints          Complaint[]
  schedules           CollectionSchedule[]
}

model Bin {
  id                    String            @id @default(uuid())
  code                  String            @unique
  name                  String
  wardId                String
  ward                  Ward              @relation(fields: [wardId], references: [id])
  latitude              Float
  longitude             Float
  capacityLiters        Float
  wasteType             String            @default("general") // organic, recyclable, hazardous, general, electronic
  areaCategory          String            @default("residential") // residential, commercial, market, industrial, pilgrimage
  status                String            @default("active") // active, maintenance, full, archived
  currentFillPercentage Float             @default(0.0)
  lastObservedAt        DateTime?
  lastCollectedAt       DateTime?
  urgency               String            @default("normal") // normal, monitor, high, critical
  priorityScore         Float             @default(0.0)
  provenance            String            @default("observed") // observed, imported, inferred, predicted, synthetic
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  observations          BinObservation[]
  collections           CollectionEvent[]
  tasks                 CollectionTask[]
  routeStops            RouteStop[]
  complaints            Complaint[]
  issues                OperationalIssue[]

  @@index([wardId])
  @@index([status])
  @@index([urgency])
  @@index([wasteType])
}

model BinObservation {
  id             String   @id @default(uuid())
  binId          String
  bin            Bin      @relation(fields: [binId], references: [id], onDelete: Cascade)
  fillPercentage Float
  observedAt     DateTime @default(now())
  observerType   String   @default("manual_inspection") // manual_inspection, citizen_report, sensor, synthetic_generator
  provenance     String   @default("observed")
  notes          String?
  createdAt      DateTime @default(now())

  @@index([binId])
  @@index([observedAt])
}

// ---------------------------------------------------------------------
// 3. WORKER COLLECTION TASKS & OPERATIONS
// ---------------------------------------------------------------------
model CollectionTask {
  id                 String    @id @default(uuid())
  binId              String
  bin                Bin       @relation(fields: [binId], references: [id], onDelete: Cascade)
  assignedWorkerId   String?
  assignedWorker     User?     @relation(fields: [assignedWorkerId], references: [id])
  vehicleId          String?
  taskPriority       String    @default("normal") // normal, monitor, high, critical
  priorityScore      Float     @default(0.0)
  status             String    @default("pending") // pending, assigned, started, collected, partially_completed, missed, blocked
  scheduledDate      DateTime  @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  observedFill       Float?
  collectedWeightKg  Float?
  notes              String?
  missedReason       String?
  photoEvidenceUrl   String?
  workerGpsLat       Float?
  workerGpsLng       Float?
  issues             OperationalIssue[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([binId])
  @@index([assignedWorkerId])
  @@index([status])
  @@index([scheduledDate])
}

model CollectionEvent {
  id             String   @id @default(uuid())
  binId          String
  bin            Bin      @relation(fields: [binId], references: [id], onDelete: Cascade)
  vehicleId      String?
  vehicle        Vehicle? @relation(fields: [vehicleId], references: [id])
  driverName     String
  collectedAt    DateTime @default(now())
  fillBefore     Float
  fillAfter      Float    @default(0.0)
  provenance     String   @default("observed")
  status         String   @default("completed") // completed, partial, skipped
  notes          String?
  createdAt      DateTime @default(now())

  @@index([binId])
  @@index([vehicleId])
  @@index([collectedAt])
}

// ---------------------------------------------------------------------
// 4. CITIZEN COMPLAINT MANAGEMENT
// ---------------------------------------------------------------------
model Complaint {
  id                 String            @id @default(uuid())
  ticketNo           String            @unique
  citizenId          String?
  citizen            User?             @relation(fields: [citizenId], references: [id])
  category           String            // overflowing_bin, illegal_dumping, damaged_bin, missed_collection, uncollected_waste, other
  description        String
  wardId             String
  ward               Ward              @relation(fields: [wardId], references: [id])
  binId              String?
  bin                Bin?              @relation(fields: [binId], references: [id])
  addressText        String?
  latitude           Float
  longitude          Float
  photoUrl           String?
  status             String            @default("submitted") // submitted, under_review, assigned, in_progress, resolved, rejected
  severity           String            @default("medium") // low, medium, high, critical
  reportedBy         String
  assignedVehicleId  String?
  assignedVehicle    Vehicle?          @relation(fields: [assignedVehicleId], references: [id])
  resolutionNotes    String?
  reportedAt         DateTime          @default(now())
  resolvedAt         DateTime?
  provenance         String            @default("observed")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  updates            ComplaintUpdate[]

  @@index([citizenId])
  @@index([wardId])
  @@index([status])
  @@index([severity])
}

model ComplaintUpdate {
  id             String    @id @default(uuid())
  complaintId    String
  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  previousStatus String
  newStatus      String
  publicComment  String    // Safe for citizen review
  internalNotes  String?   // Admin/worker private notes
  updatedBy      String
  createdAt      DateTime  @default(now())

  @@index([complaintId])
}

// ---------------------------------------------------------------------
// 5. E-WASTE & DESTINATION FACILITIES (Managed by Admin & Workers)
// ---------------------------------------------------------------------
model Facility {
  id                      String           @id @default(uuid())
  name                    String
  facilityType            String           @default("verified_ewaste_recycler") // general_waste_facility, verified_ewaste_recycler, ewaste_refurbisher, local_collection_point, scrap_dealer
  wasteType               String           @default("electronic") // electronic, general, battery
  address                 String
  businessAddress         String?
  facilityAddress         String?
  area                    String?
  latitude                Float
  longitude               Float
  locationAccuracy        String?          @default("approximate_area") // approximate_area, verified_geocoded
  acceptedWasteCategories String           // JSON array string e.g. ["electronic", "battery"]
  authorizationNumber     String?          // Official MPCB authorization certificate
  authorizationValidUntil DateTime?
  verificationStatus      String           @default("pending_confirmation") // verified, pending_confirmation, unverified, expired_or_unconfirmed
  verificationSource      String?          @default("Supplied Nashik Reference")
  lastVerifiedAt          DateTime?
  pickupAvailable         Boolean          @default(false)
  publicDropoffAvailable  Boolean          @default(false)
  activeStatus            String           @default("active")
  sourceOrganization      String           @default("Maharashtra Pollution Control Board (MPCB)")
  sourceUrl               String?
  contactPerson           String?
  contactPhone            String?
  contactEmail            String?
  provenance              String           @default("imported")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  handovers               HandoverRecord[]

  @@index([facilityType])
  @@index([verificationStatus])
}

model EWasteRequest {
  id                   String           @id @default(uuid())
  ticketNo             String           @unique
  citizenId            String?
  citizen              User?            @relation(fields: [citizenId], references: [id])
  citizenName          String
  citizenEmail         String
  contactPhone         String
  pickupAddress        String
  wardId               String?
  latitude             Float?
  longitude            Float?
  itemsDescription     String           // Specific items: e.g. 2 CRT monitors, 1 microwave
  approximateQuantity  String           // e.g. "Small bag", "Large appliance"
  estimatedWeightKg    Float?
  preferredPickupDate  DateTime?
  status               String           @default("submitted") // submitted, under_review, assigned, in_progress, collected, delivered_to_recycler, rejected
  assignedWorkerId     String?
  assignedWorker       User?            @relation("AssignedWorker", fields: [assignedWorkerId], references: [id])
  assignedFacilityId   String?
  collectionDate       DateTime?
  resolutionNotes      String?
  provenance           String           @default("observed")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  handovers            HandoverRecord[]

  @@index([citizenId])
  @@index([assignedWorkerId])
  @@index([status])
}

model HandoverRecord {
  id                   String         @id @default(uuid())
  facilityId           String
  facility             Facility       @relation(fields: [facilityId], references: [id])
  ewasteRequestId      String?
  ewasteRequest        EWasteRequest? @relation(fields: [ewasteRequestId], references: [id])
  recordedByWorkerId   String
  materialCategory     String         @default("e_waste")
  measuredWeightKg     Float
  receiptNumber        String?
  certificateUrl       String?
  notes                String?
  handoverDate         DateTime       @default(now())
  provenance           String         @default("observed")
  createdAt            DateTime       @default(now())

  @@index([facilityId])
  @@index([ewasteRequestId])
}

// ---------------------------------------------------------------------
// 6. SYSTEM ALERTS (Deduplicated & Managed)
// ---------------------------------------------------------------------
model Alert {
  id          String    @id @default(uuid())
  alertType   String    // predicted_overflow, high_priority, overdue_pickup, repeated_missed, damaged_bin
  severity    String    @default("high") // critical, high, medium, low
  binId       String?
  wardId      String?
  title       String
  description String
  status      String    @default("active") // active, acknowledged, resolved
  dedupKey    String    @unique // Unique key preventing repetitive alert spam
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([alertType])
  @@index([status])
}

// ---------------------------------------------------------------------
// 7. SCHEDULES & FESTIVALS / SPECIAL EVENTS
// ---------------------------------------------------------------------
model CollectionSchedule {
  id          String   @id @default(uuid())
  wardId      String
  ward        Ward     @relation(fields: [wardId], references: [id])
  shiftName   String   // Morning Shift, Afternoon Shift, Night Commercial
  startTime   String   // e.g. 06:30
  endTime     String   // e.g. 11:30
  daysOfWeek  String   // Monday, Wednesday, Friday
  frequency   String   @default("Daily")
  wasteType   String   @default("general")
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([wardId])
}

model FestivalEvent {
  id                               String   @id @default(uuid())
  eventName                        String   // Kumbh Mela Parvani, Ganesh Visarjan, Diwali Week
  affectedLocation                 String   // Godavari Ghats, Ramkund, Panchavati
  startDate                        DateTime
  endDate                          DateTime
  expectedActivityLevel            String   @default("high") // critical, high, medium
  wasteCategoriesAffected          String   @default("organic, general")
  demandMultiplier                 Float    @default(1.5) // Assumed demand factor
  additionalCollectionRequirements String?
  isPlanningAssumption             Boolean  @default(true)
  notes                            String?
  createdAt                        DateTime @default(now())

  @@index([startDate])
  @@index([endDate])
}

// ---------------------------------------------------------------------
// 8. VEHICLES, ROUTING & ROAD NETWORK
// ---------------------------------------------------------------------
model Vehicle {
  id               String            @id @default(uuid())
  registrationNo   String            @unique
  vehicleType      String            @default("compactor_truck")
  capacityKg       Float             @default(3500.0)
  currentLoadKg    Float             @default(0.0)
  driverName       String
  driverPhone      String?
  status           String            @default("idle") // idle, en_route, collecting, maintenance, off_duty
  trackingMode     String            @default("simulated") // simulated, real_gps
  currentLatitude  Float             @default(19.9975)
  currentLongitude Float             @default(73.7898)
  lastGpsUpdate    DateTime          @default(now())
  assignedRouteId  String?
  notes            String?
  provenance       String            @default("observed")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  collections      CollectionEvent[]
  complaints       Complaint[]
  routes           Route[]
  locationUpdates  VehicleLocationUpdate[]
}

model VehicleLocationUpdate {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  speedKmph   Float?
  mode        String   @default("simulated") // simulated, real_gps
  recordedAt  DateTime @default(now())

  @@index([vehicleId])
  @@index([recordedAt])
}

model Route {
  id                   String      @id @default(uuid())
  vehicleId            String
  vehicle              Vehicle     @relation(fields: [vehicleId], references: [id])
  depotName            String
  depotLatitude        Float
  depotLongitude       Float
  totalDistanceKm      Float
  totalDurationMinutes Float
  algorithmUsed        String
  timeComplexity       String
  pathGeoJson          String      // JSON string array of coordinate pairs
  status               String      @default("planned") // planned, active, completed, cancelled
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  stops                RouteStop[]
}

model RouteStop {
  id                       String   @id @default(uuid())
  routeId                  String
  route                    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopOrder                Int
  type                     String   // depot, bin
  binId                    String?
  bin                      Bin?     @relation(fields: [binId], references: [id])
  name                     String
  latitude                 Float
  longitude                Float
  demandKg                 Float    @default(0.0)
  cumulativeDistanceMeters Float
  cumulativeTimeMinutes    Float
  status                   String   @default("pending") // pending, completed, skipped
  createdAt                DateTime @default(now())

  @@index([routeId])
}

model RoadNode {
  id        String   @id
  name      String
  latitude  Float
  longitude Float
  wardId    String?
  createdAt DateTime @default(now())
}

model RoadEdge {
  id                String   @id
  sourceNodeId      String
  targetNodeId      String
  distanceMeters    Float
  travelTimeSeconds Float
  roadName          String
  oneWay            Boolean  @default(false)
  isBlocked         Boolean  @default(false)
  blockedReason     String?
  blockedAt         DateTime?
  createdAt         DateTime @default(now())

  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([isBlocked])
}

model OperationalIssue {
  id              String          @id @default(uuid())
  ticketNo        String          @unique
  issueType       String          // blocked_road, damaged_bin, inaccessible_point, unsafe_location, incorrect_map, vehicle_problem, other
  workerId        String?
  worker          User?           @relation(fields: [workerId], references: [id])
  taskId          String?
  task            CollectionTask? @relation(fields: [taskId], references: [id])
  binId           String?
  bin             Bin?            @relation(fields: [binId], references: [id])
  roadEdgeId      String?
  locationText    String?
  latitude        Float?
  longitude       Float?
  description     String?
  photoUrl        String?
  status          String          @default("reported") // reported, investigating, active_roadblock, resolved, rejected
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([workerId])
  @@index([issueType])
  @@index([status])
}

model SampleWorkerRecord {
  id               String   @id @default(uuid())
  workerId         String   @unique
  workerName       String
  assignedZone     String
  shift            String
  vehicleType      String
  assignedBinIds   String
  availability     String
  dataStatus       String
  verificationNote String?
  isFictional      Boolean  @default(true)
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------
// 9. DATA PROVENANCE & RECORD RETENTION
// ---------------------------------------------------------------------
model DataSource {
  id                   String   @id @default(uuid())
  name                 String
  sourceType           String   // government, open_source, municipal_feed, synthetic
  url                  String?
  licenseNotes         String?
  coverage             String?
  dateRange            String?
  acceptedRowsCount    Int      @default(0)
  rejectedRowsCount    Int      @default(0)
  dataQualityWarnings  String?
  lastImportedAt       DateTime @default(now())
  createdAt            DateTime @default(now())
}

model MLModelRecord {
  id                    String   @id @default(uuid())
  version               String   @unique
  modelType             String
  featuresUsed          String   // JSON string array
  trainingRecordsCount  Int
  trainMae              Float
  trainRmse             Float
  testMae               Float
  testRmse              Float
  baselineMae           Float
  baselineRmse          Float
  improvementPercentage Float
  weightsJson           String?  // JSON string serialized weights
  isActive              Boolean  @default(false)
  status                String   @default("candidate") // active, candidate, archived
  provenance            String   @default("synthetic")
  trainedAt             DateTime @default(now())
  createdAt             DateTime @default(now())
}
